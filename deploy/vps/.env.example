# ORBES GENOME CODE on one OVH VPS: stack configuration (deploy/vps/.env).
#
#   scripts/setup.sh        creates .env from this file with fresh secrets (recommended)
#   cp .env.example .env    by hand: then fill in every value marked REQUIRED, chmod 600 .env
#
# NEVER commit the filled-in .env (deploy/vps/.gitignore excludes it). Escrow
# KEY_ENCRYPTION_KEY, COOKIE_SECRET and IP_HASH_PEPPER offline: the encrypted
# backups (scripts/backup.sh) deliberately do NOT contain them.
#
# compose.yaml reads this file for ${…} interpolation and hands each container
# only the variables it lists (the app never sees the backup or GeoIP-download
# settings). Wired by compose.yaml itself, NOT read from here: ORBES_ENV=production,
# PUBLIC_ORIGIN=https://$APP_DOMAIN, DATABASE_URL, HOST, PORT,
# TRUST_PROXY=$CADDY_EDGE_IP, KEY_PROVIDER=local, KEY_DIR, MIGRATE_ON_START=true,
# GEO_MMDB_PATH=/var/lib/orbes/geoip/$GEOIP_FILE.
#
# Secret generators (setup.sh uses the same):
#   48-byte secret, base64url:   openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'
#   32-byte key, base64url:      openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
#   URL-safe password:           openssl rand -hex 24

# ── Public endpoint (Caddy) ────────────────────────────────────────────────

# REQUIRED. Host name of the service, without scheme. DNS: A (and optionally AAAA)
# record pointing to this VPS. The app's PUBLIC_ORIGIN becomes https://$APP_DOMAIN.
APP_DOMAIN=verify.theorbes.com

# REQUIRED. E-mail for the ACME account (Let's Encrypt expiry / incident notices).
ACME_EMAIL=ops@example.com

# acme (production: Let's Encrypt, ZeroSSL as fallback) | internal (Caddy's local CA,
# for tests on a private name such as verify.orbes.test; browsers will not trust it).
TLS_MODE=acme

# direct (default: clients reach this VPS directly) | cloudflare (Cloudflare proxy in
# front; trusts Cloudflare's ranges, see docs/DEPLOYMENT.md §15.11). With cloudflare you
# may also set GEO_MODE=cloudflare.
EDGE_MODE=direct

# Optional allowlist for /admin and /api/admin: space-separated IPs or CIDRs, e.g.
# "203.0.113.7/32 2001:db8:1234::/48". Default: everyone (the app still enforces TOTP).
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0

# Host ports Caddy publishes (keep 80/443 in production: ACME needs them).
HTTP_PORT=80
HTTPS_PORT=443

# Internal edge network (Caddy ↔ app). Caddy has the fixed address CADDY_EDGE_IP (inside
# EDGE_SUBNET, OUTSIDE EDGE_DYNAMIC_RANGE, from which every other container gets its
# address), and the app's TRUST_PROXY is exactly CADDY_EDGE_IP. Change the three
# together, only if the subnet collides with another network on the host.
EDGE_SUBNET=172.30.80.0/28
EDGE_DYNAMIC_RANGE=172.30.80.8/29
CADDY_EDGE_IP=172.30.80.2

# ── Database (postgres:17 container, internal network only) ────────────────

POSTGRES_DB=orbes
POSTGRES_USER=orbes
# REQUIRED. URL-safe characters only (embedded in DATABASE_URL): openssl rand -hex 24.
# Only applied when the pgdata volume is first created.
POSTGRES_PASSWORD=

# ── App secrets (REQUIRED; see genome/.env.example for the rules) ──────────

# ≥ 32 random characters. Signs cookies.
COOKIE_SECRET=
# ≥ 32 random characters, different from COOKIE_SECRET. Pseudonymises IPs and device ids.
IP_HASH_PEPPER=
# base64url (no padding) of exactly 32 random bytes: encrypts the signing keys at rest
# and seals admin TOTP secrets. Escrow it offline; without it the keys volume is useless.
KEY_ENCRYPTION_KEY=

# ── First admin (first start only; remove both after TOTP enrolment) ───────

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── App settings ───────────────────────────────────────────────────────────

LOG_LEVEL=info

# Geolocation for anomaly scoring. mmdb (default here): local DB-IP "IP to City Lite"
# database (CC BY 4.0, attribution "IP Geolocation by DB-IP", https://db-ip.com) in the
# geoip volume, refreshed weekly by scripts/geoip-update.sh (systemd timer orbes-geoip).
# A missing file only disables geolocation (warning in the log), never verification.
# cloudflare: only with EDGE_MODE=cloudflare. none: no geolocation.
GEO_MODE=mmdb
# File name inside the geoip volume (the app reads /var/lib/orbes/geoip/$GEOIP_FILE).
GEOIP_FILE=dbip-city-lite.mmdb
# Proxy for the GeoIP download only, if the VPS has no direct internet access (rare).
GEOIP_HTTPS_PROXY=

# Optional app tunables, passed to the app by compose.yaml (genome/.env.example documents
# each one; unset = the app's default, shown here). Uncomment to override.
# ADMIN_REQUIRE_MFA=true
# RATE_LIMIT_VERIFY_PER_MINUTE=60
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_ADMIN_PER_MINUTE=300
# RATE_LIMIT_API_PER_MINUTE=120
# SESSION_TTL_ACCOUNT_HOURS=720
# SESSION_TTL_ADMIN_HOURS=8
# ANOMALY_SUSPICIOUS_THRESHOLD=60
# ANOMALY_IMPOSSIBLE_TRAVEL_KMH=900
# ANOMALY_MIN_TRAVEL_KM=500
# ANOMALY_VELOCITY_WINDOW_MIN=60
# ANOMALY_VELOCITY_MAX_SCANS=20
# ANOMALY_VELOCITY_MIN_DEVICES=5
# ANOMALY_DEVICE_WINDOW_DAYS=7
# ANOMALY_DEVICE_MAX=12
# ANOMALY_GEO_WINDOW_DAYS=7
# ANOMALY_GEO_MAX_COUNTRIES=3
# ANOMALY_DECAY_DAYS=30

# ── Image and resources ────────────────────────────────────────────────────

# Image tag of the app (orbes-genome:<tag>). scripts/deploy.sh sets it to the deployed
# commit; the previous one is kept for rollback.
ORBES_IMAGE_TAG=latest
# Set by scripts/deploy.sh for each run (hash of Caddyfile + caddy.d/): do not set it here.
# CADDY_CONFIG_HASH=

# Container limits, sized for a 2 vCPU / 4 GB VPS (the GeoIP database alone takes
# ~130 MB of the app's memory, twice that while it reloads).
APP_MEM_LIMIT=768m
APP_CPUS=1.5
PG_MEM_LIMIT=1g
PG_CPUS=1.5
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
CADDY_MEM_LIMIT=256m
CADDY_CPUS=1.0

# ── Backups (scripts/backup.sh, systemd timer orbes-backup) ────────────────

# Local directory for encrypted archives (created by bootstrap-ubuntu.sh, owner orbes, 0700).
BACKUP_DIR=/var/backups/orbes
# File with the age recipient(s) (public keys, one per line). setup.sh writes it; the
# private identity is kept OFFLINE, never on this server.
BACKUP_AGE_RECIPIENTS_FILE=/opt/orbes/backup-recipients.txt
# Retention: newest N daily archives, newest N weekly archives (first backup of each ISO week).
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Optional off-site copy with rclone to OVH Object Storage (S3-compatible), e.g.
# "ovh-s3:orbes-backups/verify" (remote:bucket/prefix). Empty = local only.
BACKUP_RCLONE_DEST=

# ── Build (scripts/deploy.sh) ──────────────────────────────────────────────

# Optional PEM file of an extra CA trusted during `npm ci` (TLS-inspecting proxy only).
# Passed as a BuildKit secret, never stored in the image.
BUILD_EXTRA_CA_FILE=
