# ORBES GENOME CODE: TLS edge for the verification service on the OVH VPS.
#
# Runs in the official caddy:2 image (deploy/vps/compose.yaml). Every {$VAR}
# comes from deploy/vps/.env through compose and is substituted when Caddy
# loads this file. Validate a change before deploying it:
#
#   docker compose exec caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#
# Switches (deploy/vps/.env):
#   APP_DOMAIN          public host name, e.g. verify.theorbes.com (no scheme)
#   TLS_MODE            acme (default: Let's Encrypt, ZeroSSL as fallback) | internal (Caddy's
#                       own local CA: local tests only, browsers will not trust it)
#   ACME_EMAIL          account e-mail for the ACME CA (expiry and incident notices)
#   EDGE_MODE           direct (default: clients connect to this VPS) | cloudflare (orange-cloud
#                       proxy in front: Cloudflare's ranges become trusted proxies, see below)
#   ADMIN_ALLOWED_IPS   space-separated IPs/CIDRs allowed on /admin and /api/admin
#                       (default 0.0.0.0/0 ::/0 = no restriction; the app still enforces TOTP)
#
# Client IP contract with the app (TRUST_PROXY = Caddy's fixed address on the
# internal `edge` network, set by compose):
#   * The app receives exactly ONE X-Forwarded-For entry: {client_ip}.
#   * EDGE_MODE=direct: no proxy is trusted, so {client_ip} is the TCP peer.
#     Any X-Forwarded-For / X-Real-IP / CF-* header sent by a client is
#     discarded, never forwarded: clients cannot choose the IP the app sees
#     (rate limits, IP pseudonyms and anomaly scoring stay per real client).
#   * EDGE_MODE=cloudflare: only peers inside Cloudflare's published ranges are
#     trusted, and {client_ip} comes from CF-Connecting-IP. Lock the origin to
#     those ranges as well (docs/DEPLOYMENT.md §15.11).
#
# HSTS, CSP, frame and permission headers are set by the app itself: nothing
# here adds or overrides security headers (no duplicates, no conflicts).
{
	# Admin API on the container's loopback only (used by `caddy reload` and the healthcheck).
	admin localhost:2019
	# Runtime log (stderr). Access lines never go here: the only access log is the
	# filtered one of the site below (otherwise the automatic HTTP→HTTPS redirect and
	# requests for unknown hosts would be logged unfiltered: full IPs, query strings).
	# The error logger (http.log.error, e.g. a 502 while the app restarts) embeds the
	# whole request, so this log gets the same filter as the access log.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				request>tls delete
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
		exclude http.log.access
	}
	servers {
		# caddy.d/edge-direct.caddy or caddy.d/edge-cloudflare.caddy
		import caddy.d/edge-{$EDGE_MODE:direct}.caddy
	}
}

# ── TLS modes (site block) ─────────────────────────────────────────────────

(tls_acme) {
	tls {$ACME_EMAIL}
}

(tls_internal) {
	tls internal
}

# ── Origin lock per edge mode (site block) ─────────────────────────────────

(site_direct) {
	# Clients connect directly: nothing to lock.
}

(site_cloudflare) {
	# Only Cloudflare (a trusted proxy, caddy.d/edge-cloudflare.caddy) may talk to this
	# origin; private peers stay allowed for checks run on the VPS itself (deploy.sh smoke
	# tests). Defence in depth on top of the ufw rules of docs/DEPLOYMENT.md §15.11.
	@not_cloudflare {
		not vars {http.vars.trusted_proxy} true
		not remote_ip private_ranges
	}
	respond @not_cloudflare "Forbidden" 403 {
		close
	}
}

# ── Upstream header policy per edge mode (inside reverse_proxy) ────────────

(upstream_direct) {
	# Nothing in front of Caddy may vouch for geolocation: drop forged Cloudflare headers
	# so GEO_MODE=cloudflare can never be fed by a client.
	header_up -Cf-Connecting-Ip
	header_up -Cf-Ipcountry
	header_up -Cf-Iplatitude
	header_up -Cf-Iplongitude
	header_up -Cf-Region
	header_up -Cf-Ipcity
	header_up -True-Client-Ip
}

(upstream_cloudflare) {
	# cf-* headers are kept: the peer is a trusted Cloudflare edge (trusted_proxies_strict).
	header_up -True-Client-Ip
}

# ── The app upstream (inside each reverse_proxy below) ─────────────────────

(app_upstream) {
	# Exactly one entry: the client IP as Caddy determined it (see the contract above).
	header_up X-Forwarded-For {client_ip}
	header_up -X-Real-Ip
	header_up -Forwarded
	import upstream_{$EDGE_MODE:direct}

	# Ride out an app restart (deploy, rollback) instead of answering 502 at once.
	lb_try_duration 15s
	lb_try_interval 250ms
	transport http {
		dial_timeout 5s
		# The app answers within 30 s (requestTimeout); give it a little more.
		response_header_timeout 35s
	}
}

{$APP_DOMAIN} {
	import tls_{$TLS_MODE:acme}
	import site_{$EDGE_MODE:direct}

	# Access log: JSON on stdout, without query strings, cookies, headers or full client IPs.
	# (The app logs no client IP at all; the masked prefix here is enough to triage abuse.)
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				resp_headers delete
				request>tls delete
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
			}
		}
	}

	# The app accepts JSON bodies up to 16 KB; anything far larger is refused at the edge.
	# Two exceptions. The console's photograph uploads (F-04, P-R02, P-X01, the LIVE RELEASES: a
	# model's reference photograph, a piece's, a photograph of a model's lookbook gallery, a
	# photograph of a post of the owners' circle, a LIVE RELEASE's silhouette), whose body is
	# the image itself (at most 1 MiB in the app, routes/admin/media.ts MEDIA_UPLOAD_ROUTES),
	# get 1200KB (1 200 000 bytes). The prepaid label of a yearly care (BP-19 T6), whose body is
	# the PDF itself (at most 2 MiB in the app, routes/admin/care.ts CARE_LABEL_UPLOAD_ROUTE),
	# gets 2200KB. The three matchers exclude each other, so exactly one limit applies to a
	# request: a DELETE of a photograph or a silhouette, the order of a gallery or of a post's
	# photographs (a PATCH), or any other path, keeps 64KB.
	@photo_upload {
		method POST
		path_regexp ^/api/admin/(models/[^/]+/(image|gallery)|products/[^/]+/photo|circle/posts/[^/]+/photos|live/[^/]+/silhouette)/?$
	}
	request_body @photo_upload {
		max_size 1200KB
	}
	@label_upload {
		method POST
		path_regexp ^/api/admin/care/[^/]+/label/?$
	}
	request_body @label_upload {
		max_size 2200KB
	}
	@not_upload {
		not {
			method POST
			path_regexp ^/api/admin/(models/[^/]+/(image|gallery)|products/[^/]+/photo|circle/posts/[^/]+/photos|live/[^/]+/silhouette|care/[^/]+/label)/?$
		}
	}
	request_body @not_upload {
		max_size 64KB
	}

	# The LIVE RELEASES' streams (Server-Sent Events, genome/src/server/http/live-stream.ts LIVE_STREAM_ROUTES: a
	# viewer's room, the boutique board, the console's live board) are never compressed and are flushed at once: each
	# event reaches the phone the moment the app writes it, where compression would hold the first bytes back until a
	# block fills. Every other response is compressed. The two matchers exclude each other, so exactly one
	# reverse_proxy below serves a request.
	@live_stream {
		path_regexp ^/api/(v1/live/[^/]+/(stream|board/stream)|admin/live/[^/]+/stream)/?$
	}
	@not_live_stream {
		not path_regexp ^/api/(v1/live/[^/]+/(stream|board/stream)|admin/live/[^/]+/stream)/?$
	}

	encode @not_live_stream zstd gzip

	# Optional allowlist for the admin console and the admin API (off by default).
	@admin_blocked {
		path /admin /admin/* /api/admin /api/admin/*
		not client_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
	}
	respond @admin_blocked "Forbidden" 403 {
		close
	}

	# No product fingerprinting (security headers come from the app, see above).
	header {
		-Server
		-Via
	}

	reverse_proxy @live_stream app:8080 {
		import app_upstream
		# Each event passed on as soon as the app writes it (Caddy does so by itself for text/event-stream; said
		# here, it does not depend on the response's type). The stream's own heartbeat (20 s) keeps it open.
		flush_interval -1
	}

	reverse_proxy @not_live_stream app:8080 {
		import app_upstream
	}
}
