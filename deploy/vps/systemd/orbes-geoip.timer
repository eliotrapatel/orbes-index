# ORBES GENOME CODE: refresh the GeoIP database monthly. DB-IP publishes each
# month's edition at the start of the month; the updater falls back to the
# previous edition while the current one is not out yet.
[Unit]
Description=Monthly ORBES GENOME CODE GeoIP refresh

[Timer]
OnCalendar=*-*-05 04:41:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
