# ORBES GENOME CODE: refresh the GeoIP database weekly. DB-IP publishes each
# month's edition at the start of the month; a run before it is out falls back
# to the previous edition, so a weekly run picks the new one up within days.
# Runs that find the current edition already installed download nothing.
[Unit]
Description=Weekly ORBES GENOME CODE GeoIP refresh

[Timer]
OnCalendar=Mon *-*-* 04:41:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
