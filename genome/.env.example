# ORBES GENOME CODE: configuration template.
#
#   cp .env.example .env      then fill in every value marked REQUIRED.
#
# Every variable the server, the CLIs (scripts/db.ts, scripts/keys.ts, scripts/admin.ts) and
# docker-compose.yml read is listed here. The server validates them at start
# (src/server/config.ts) and refuses to start, naming each problem, when one
# is missing or unsafe. An empty value counts as unset.
#
# NEVER commit a filled-in copy. Secrets left empty below are deliberate: the
# production server will not start until you generate real ones.
#
# Generators (any equivalent CSPRNG is fine; `openssl rand` has no base64url
# output, hence the tr pipeline):
#   32-byte key, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#                           openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
#   48-byte secret:          node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#                           openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'
#   URL-safe password:       openssl rand -hex 24
#
# Deployment runbook (TLS edge, first key, first admin, backups, rotation):
# ../docs/DEPLOYMENT.md

# ── Runtime ────────────────────────────────────────────────────────────────

# development | test | production. The Docker image defaults to production.
# Production refuses pglite, the memory key provider, development secrets and an
# http:// PUBLIC_ORIGIN, and requires admin TOTP after first sign-in.
ORBES_ENV=production

# Interface and port the server listens on. docker-compose.yml pins these to
# 0.0.0.0:8080 inside the container; publish with APP_BIND / APP_PORT below.
HOST=0.0.0.0
PORT=8080

# REQUIRED in production. The public origin users reach (scheme://host[:port],
# no path, no trailing slash). Used for the CSRF Origin check: it must match the
# browser's address bar exactly. https:// only in production.
PUBLIC_ORIGIN=https://verify.example.com

# Proxy trust for client IPs (X-Forwarded-For), passed to Fastify: false, or a
# comma-separated list of the PROXY addresses / CIDRs / names (loopback,
# linklocal, uniquelocal). With docker-compose.yml and a reverse proxy on the
# host, the proxy reaches the app from the Docker network gateway: use
# uniquelocal. Without it, every client shares the proxy's IP for rate limiting.
# Production refuses `true` (it trusts the left-most X-Forwarded-For entry,
# which the client writes: rate limits and IP pseudonyms become forgeable) and
# hop counts such as `1` (ambiguous); list the proxies instead. Behind
# Cloudflare, list Cloudflare's published IP ranges (and your own proxy).
TRUST_PROXY=uniquelocal

# pino log level: fatal | error | warn | info | debug | trace | silent
# (default: info in production, debug in development, warn in test).
LOG_LEVEL=info

# Apply pending database migrations at start (production only; development and
# test always migrate). Without it a production server refuses to start on an
# outdated schema; run `node --import tsx scripts/db.ts migrate` instead.
MIGRATE_ON_START=true

# Admin sessions must have passed TOTP before using anything but the sign-in and
# enrolment routes. Default: true in production, false elsewhere. Setting it to
# false in production is accepted with a startup warning (enrolment window
# only); prefer enrolling admins with scripts/admin.ts totp-setup / totp-enable.
# ADMIN_REQUIRE_MFA=true

# Development only: `node --import tsx src/server/index.ts --demo` (or
# ORBES_DEMO=true) starts on pglite:memory with the demo dataset loaded; it is
# refused in production and with any other DATABASE_URL.
# ORBES_DEMO=false

# ── Database ───────────────────────────────────────────────────────────────

# postgres://user:password@host:5432/db | pglite:/absolute/dir | pglite:memory
# (pglite = PostgreSQL in WebAssembly, development and demos only).
# docker-compose.yml builds this from the POSTGRES_* values below; set it
# yourself only when running the image without compose.
DATABASE_URL=

# Used by docker-compose.yml for the postgres:17 service and DATABASE_URL.
POSTGRES_DB=orbes
POSTGRES_USER=orbes
# REQUIRED with compose. URL-safe characters only (it is embedded in DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Secrets ────────────────────────────────────────────────────────────────

# REQUIRED in production. ≥ 32 characters, random. Signs cookies (sessions, device id).
COOKIE_SECRET=

# REQUIRED in production. ≥ 32 characters, random, different from COOKIE_SECRET.
# HMAC key that pseudonymises IP addresses, device and session ids before they
# are stored: raw IPs are never kept. Rotating it breaks the link with older
# scan history (anomaly scoring restarts from scratch).
IP_HASH_PEPPER=

# ── Signing keys ───────────────────────────────────────────────────────────

# local (production) | memory (development/test only; keys vanish on restart).
KEY_PROVIDER=local

# Absolute directory of the encrypted Ed25519 key files (created 0700, files 0600).
# docker-compose.yml mounts the `keys` volume here.
KEY_DIR=/var/lib/orbes/keys

# REQUIRED with KEY_PROVIDER=local. base64url (no padding) of exactly 32 random
# bytes: the AES-256-GCM key that encrypts every signing key at rest. Store it in
# your secret manager and back it up separately from the key volume; without it
# the keys cannot be decrypted. Generate: see the 32-byte key generator above.
KEY_ENCRYPTION_KEY=

# ── First admin (first start only) ─────────────────────────────────────────

# Creates this ADMIN when the database has no admin yet; ignored afterwards.
# Password ≥ 12 characters. In production the admin must enrol TOTP at first
# sign-in. Remove both values from the environment once the admin exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Password for `scripts/admin.ts create` (read from the environment, never from
# argv). Set it for that one command only, e.g. ADMIN_PASSWORD=… node --import tsx scripts/admin.ts create …
# ADMIN_PASSWORD=

# ── Geolocation for anomaly scoring ────────────────────────────────────────

# none | mmdb | cloudflare (cf-ipcountry / cf-iplatitude / cf-iplongitude) | headers.
# mmdb (recommended on the VPS, no CDN needed): the client IP the app already
# computes (TRUST_PROXY applied) is looked up in a local GeoIP file, DB-IP
# "IP to City Lite" (CC BY 4.0, "IP Geolocation by DB-IP", see ../NOTICE.md),
# installed and refreshed monthly by `node --import tsx scripts/geoip-update.ts`.
# Country + coordinates rounded to 1 decimal; raw IPs are never logged or
# stored. A missing or damaged file only disables geo (one warning in the log);
# a replaced file is picked up within 10 minutes without a restart.
# mmdb, cloudflare and headers all require TRUST_PROXY in production (refused
# otherwise): behind the TLS proxy the socket address is the proxy's own, and a
# cf-* or geo header that reaches the app without passing the trusted edge is
# client-forged. `headers` reads the names below: only use it behind a proxy
# that overwrites these headers on every request.
GEO_MODE=mmdb
# REQUIRED with GEO_MODE=mmdb: absolute path of the .mmdb file inside the
# container (mount the GeoIP volume / directory there, read-only for the app).
GEO_MMDB_PATH=/var/lib/orbes/geoip/dbip-city-lite.mmdb
GEO_COUNTRY_HEADER=
GEO_LAT_HEADER=
GEO_LON_HEADER=

# ── Rate limits (requests per minute per client IP) ────────────────────────

RATE_LIMIT_VERIFY_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ADMIN_PER_MINUTE=300
# Every other public and account route (health, keys, categories, account reads).
RATE_LIMIT_API_PER_MINUTE=120

# ── Sessions ───────────────────────────────────────────────────────────────

# Customer sessions (1..8760 h) and admin sessions (1..168 h).
SESSION_TTL_ACCOUNT_HOURS=720
SESSION_TTL_ADMIN_HOURS=8

# ── Scan-history retention ─────────────────────────────────────────────────

# Scan events (with their authentication events, scan tokens and customers' reports)
# older than this many days are purged by housekeeping every 10 minutes, always after the
# same pass has counted every complete day into the anonymous daily statistics of the
# console's Analytics view, which the purge never touches. 30..3650 whole days, and never
# below the anomaly look-back (longest ANOMALY_*_WINDOW / ANOMALY_DECAY_DAYS: 30 by
# default). Unset keeps scan history indefinitely; production then logs a warning. The
# period is a legal decision: set the one agreed with counsel (DATABASE.md §10).
# SCAN_RETENTION_DAYS=395

# ── Ownership transfers ────────────────────────────────────────────────────

# A transfer code is accepted for the piece the recipient scanned, signed in,
# within 15 minutes of that scan (F-03): the acceptance names the piece and
# carries the scan's token, and a code of another piece is refused. Default:
# true. false makes both optional, for an acceptance assisted by ORBES Client
# Services (whatever is sent is still checked); production then logs a warning
# at every start. API level only: the verify app still asks for a signed-in
# scan of the piece, and the console accepts no transfer, so it does not help a
# client whose piece cannot be scanned (docs/LAUNCH.md §11); while it is set,
# the check is off for every pending transfer. Set it back once the assisted
# acceptance is done.
# TRANSFER_ACCEPT_REQUIRE_PRODUCT=true

# ── ORBES Client Services (public contact) ─────────────────────────────────

# How customers reach ORBES Client Services, as supplied by the brand. Served
# publicly by GET /api/v1/client-services (cached 5 minutes): the verification
# app offers CONTACT ORBES CLIENT SERVICES (an email prefilled with the scan
# reference and the result), the phone and the hours on every non-authentic
# result and on a warranty that no longer applies. All optional; with neither
# an email nor a phone, nothing is shown.
#   EMAIL  a plain mailbox: letters, digits and . _ + - (e.g. clientservices@theorbes.com)
#   PHONE  international format: + then 7–15 digits, single spaces, dots or hyphens between them (e.g. +33 1 23 45 67 89)
#   HOURS  one line of plain text, ≤ 120 characters (e.g. Monday to Saturday, 10:00–19:00, Paris time); only with EMAIL or PHONE
CLIENT_SERVICES_EMAIL=
CLIENT_SERVICES_PHONE=
CLIENT_SERVICES_HOURS=

# ── Anomaly detection (INTERNAL thresholds, never exposed by the API) ──────

# Defaults shown; uncomment only to tune. Unknown ANOMALY_* names are rejected.
# ANOMALY_SUSPICIOUS_THRESHOLD=60      # risk score (1..100) from which a scan is SUSPICIOUS
# ANOMALY_IMPOSSIBLE_TRAVEL_KMH=900    # speed between consecutive scans that is impossible
# ANOMALY_MIN_TRAVEL_KM=500            # ignore distances below this
# ANOMALY_VELOCITY_WINDOW_MIN=60       # scan-velocity window, minutes
# ANOMALY_VELOCITY_MAX_SCANS=20        # more scans than this in the window…
# ANOMALY_VELOCITY_MIN_DEVICES=5       # …from at least this many devices
# ANOMALY_DEVICE_WINDOW_DAYS=7         # device-diversity window, days
# ANOMALY_DEVICE_MAX=12                # more distinct devices than this in the window
# ANOMALY_GEO_WINDOW_DAYS=7            # geographic-dispersion window, days
# ANOMALY_GEO_MAX_COUNTRIES=3          # more distinct countries than this in the window
# ANOMALY_DECAY_DAYS=30                # findings fade linearly over this many days

# ── docker-compose.yml only ────────────────────────────────────────────────

# Host address and port the app is published on (keep 127.0.0.1 behind a reverse proxy).
APP_BIND=127.0.0.1
APP_PORT=8080
# Image tag built / run by compose.
ORBES_IMAGE_TAG=latest
# Path of this file for compose's env_file (default .env); export it in the shell
# to keep secrets outside the checkout, e.g. /etc/orbes/genome.env.
# ORBES_ENV_FILE=/etc/orbes/genome.env

# ── Demo dataset (development only) ────────────────────────────────────────

# Password of the eight demo customer accounts (…@example.com) created by
# `scripts/db.ts seed`; random and printed once when unset. ≥ 12 characters.
DEMO_ACCOUNT_PASSWORD=

# Local trial instead of production (plain http on localhost, admin without
# TOTP, signing key created automatically, demo dataset allowed):
#   ORBES_ENV=development
#   PUBLIC_ORIGIN=http://localhost:8080
#   TRUST_PROXY=false
# then: docker compose exec app node --import tsx scripts/db.ts seed
