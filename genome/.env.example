# ORBES GENOME CODE: configuration template.
#
#   cp .env.example .env      then fill in every value marked REQUIRED.
#
# Every variable the server, the CLIs (scripts/db.ts, scripts/keys.ts) and
# docker-compose.yml read is listed here. The server validates them at start
# (src/server/config.ts) and refuses to start, naming each problem, when one
# is missing or unsafe. An empty value counts as unset.
#
# NEVER commit a filled-in copy. Secrets left empty below are deliberate: the
# production server will not start until you generate real ones.
#
# Generators (any equivalent CSPRNG is fine; `openssl rand` has no base64url
# output, hence the tr pipeline):
#   32-byte key, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#                           openssl rand -base64 32 | tr -d '\n=' | tr '+/' '-_'
#   48-byte secret:          node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#                           openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'
#   URL-safe password:       openssl rand -hex 24
#
# Deployment runbook (TLS edge, first key, first admin, backups, rotation):
# ../docs/DEPLOYMENT.md

# ── Runtime ────────────────────────────────────────────────────────────────

# development | test | production. The Docker image defaults to production.
# Production refuses pglite, the memory key provider, development secrets and an
# http:// PUBLIC_ORIGIN, and requires admin TOTP after first sign-in.
ORBES_ENV=production

# Interface and port the server listens on. docker-compose.yml pins these to
# 0.0.0.0:8080 inside the container; publish with APP_BIND / APP_PORT below.
HOST=0.0.0.0
PORT=8080

# REQUIRED in production. The public origin users reach (scheme://host[:port],
# no path, no trailing slash). Used for the CSRF Origin check: it must match the
# browser's address bar exactly. https:// only in production.
PUBLIC_ORIGIN=https://verify.example.com

# Proxy trust for client IPs (X-Forwarded-For), passed to Fastify: true, false,
# or a comma-separated list of addresses / CIDRs / names (loopback, linklocal,
# uniquelocal). With docker-compose.yml and a reverse proxy on the host, the
# proxy reaches the app from the Docker network gateway: use uniquelocal.
# Without it, every client shares the proxy's IP for rate limiting.
TRUST_PROXY=uniquelocal

# pino log level: fatal | error | warn | info | debug | trace (default: info in production).
LOG_LEVEL=info

# Apply pending database migrations at start (production only; development and
# test always migrate). Without it a production server refuses to start on an
# outdated schema; run `node --import tsx scripts/db.ts migrate` instead.
MIGRATE_ON_START=true

# ── Database ───────────────────────────────────────────────────────────────

# postgres://user:password@host:5432/db | pglite:/absolute/dir | pglite:memory
# (pglite = PostgreSQL in WebAssembly, development and demos only).
# docker-compose.yml builds this from the POSTGRES_* values below; set it
# yourself only when running the image without compose.
DATABASE_URL=

# Used by docker-compose.yml for the postgres:17 service and DATABASE_URL.
POSTGRES_DB=orbes
POSTGRES_USER=orbes
# REQUIRED with compose. URL-safe characters only (it is embedded in DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Secrets ────────────────────────────────────────────────────────────────

# REQUIRED in production. ≥ 32 characters, random. Signs cookies (sessions, device id).
COOKIE_SECRET=

# REQUIRED in production. ≥ 32 characters, random, different from COOKIE_SECRET.
# HMAC key that pseudonymises IP addresses, device and session ids before they
# are stored: raw IPs are never kept. Rotating it breaks the link with older
# scan history (anomaly scoring restarts from scratch).
IP_HASH_PEPPER=

# ── Signing keys ───────────────────────────────────────────────────────────

# local (production) | memory (development/test only; keys vanish on restart).
KEY_PROVIDER=local

# Absolute directory of the encrypted Ed25519 key files (created 0700, files 0600).
# docker-compose.yml mounts the `keys` volume here.
KEY_DIR=/var/lib/orbes/keys

# REQUIRED with KEY_PROVIDER=local. base64url (no padding) of exactly 32 random
# bytes: the AES-256-GCM key that encrypts every signing key at rest. Store it in
# your secret manager and back it up separately from the key volume; without it
# the keys cannot be decrypted. Generate: see the 32-byte key generator above.
KEY_ENCRYPTION_KEY=

# ── First admin (first start only) ─────────────────────────────────────────

# Creates this ADMIN when the database has no admin yet; ignored afterwards.
# Password ≥ 12 characters. In production the admin must enrol TOTP at first
# sign-in. Remove both values from the environment once the admin exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Geolocation for anomaly scoring ────────────────────────────────────────

# none | cloudflare (cf-ipcountry / cf-iplatitude / cf-iplongitude) | headers.
# `headers` reads the names below and requires TRUST_PROXY in production: only
# use it behind a proxy that overwrites these headers on every request.
GEO_MODE=none
GEO_COUNTRY_HEADER=
GEO_LAT_HEADER=
GEO_LON_HEADER=

# ── Rate limits (requests per minute per client IP) ────────────────────────

RATE_LIMIT_VERIFY_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_ADMIN_PER_MINUTE=300

# ── Sessions ───────────────────────────────────────────────────────────────

# Customer sessions (1..8760 h) and admin sessions (1..168 h).
SESSION_TTL_ACCOUNT_HOURS=720
SESSION_TTL_ADMIN_HOURS=8

# ── Anomaly detection (INTERNAL thresholds, never exposed by the API) ──────

# Defaults shown; uncomment only to tune. Unknown ANOMALY_* names are rejected.
# ANOMALY_SUSPICIOUS_THRESHOLD=60      # risk score (1..100) from which a scan is SUSPICIOUS
# ANOMALY_IMPOSSIBLE_TRAVEL_KMH=900    # speed between consecutive scans that is impossible
# ANOMALY_MIN_TRAVEL_KM=500            # ignore distances below this
# ANOMALY_VELOCITY_WINDOW_MIN=60       # scan-velocity window, minutes
# ANOMALY_VELOCITY_MAX_SCANS=20        # more scans than this in the window…
# ANOMALY_VELOCITY_MIN_DEVICES=5       # …from at least this many devices
# ANOMALY_DEVICE_WINDOW_DAYS=7         # device-diversity window, days
# ANOMALY_DEVICE_MAX=12                # more distinct devices than this in the window
# ANOMALY_GEO_WINDOW_DAYS=7            # geographic-dispersion window, days
# ANOMALY_GEO_MAX_COUNTRIES=3          # more distinct countries than this in the window
# ANOMALY_DECAY_DAYS=30                # findings fade linearly over this many days

# ── docker-compose.yml only ────────────────────────────────────────────────

# Host address and port the app is published on (keep 127.0.0.1 behind a reverse proxy).
APP_BIND=127.0.0.1
APP_PORT=8080
# Image tag built / run by compose.
ORBES_IMAGE_TAG=latest
# Path of this file for compose's env_file (default .env); export it in the shell
# to keep secrets outside the checkout, e.g. /etc/orbes/genome.env.
# ORBES_ENV_FILE=/etc/orbes/genome.env

# ── Demo dataset (development only) ────────────────────────────────────────

# Password of the eight demo customer accounts (…@example.com) created by
# `scripts/db.ts seed`; random and printed once when unset. ≥ 12 characters.
DEMO_ACCOUNT_PASSWORD=

# Local trial instead of production (plain http on localhost, admin without
# TOTP, signing key created automatically, demo dataset allowed):
#   ORBES_ENV=development
#   PUBLIC_ORIGIN=http://localhost:8080
#   TRUST_PROXY=false
# then: docker compose exec app node --import tsx scripts/db.ts seed
